{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/pv-udpv/claude-plugin-schemas/main/schemas/claude-plugin.schema.json",
  "title": "Claude Code plugin.json manifest",
  "description": "Strict JSON Schema (Draft 2020-12) for .claude-plugin/plugin.json — Claude Code Plugins Reference v2026-05-12 (https://code.claude.com/docs/en/plugins-reference).",
  "type": "object",
  "additionalProperties": false,
  "required": ["name"],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri",
      "description": "JSON Schema URL for editor autocomplete. Ignored at load time."
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 128,
      "description": "Unique identifier. kebab-case, no spaces. Used for namespacing components."
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$",
      "description": "Semantic version. Pins plugin version; falls back to git commit SHA if omitted."
    },
    "description": {
      "type": "string",
      "maxLength": 1024,
      "description": "Brief explanation of plugin purpose."
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "email": { "type": "string", "format": "email" },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "homepage": { "type": "string", "format": "uri" },
    "repository": {
      "type": "string",
      "format": "uri",
      "description": "MUST be a string URL, not an object. Object form causes validation errors."
    },
    "license": {
      "type": "string",
      "description": "SPDX license identifier (e.g. MIT, Apache-2.0)."
    },
    "keywords": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },

    "skills": {
      "$ref": "#/$defs/pathOrPaths",
      "description": "Custom skill directories containing <name>/SKILL.md. ADDS to default skills/."
    },
    "commands": {
      "$ref": "#/$defs/pathOrPaths",
      "description": "Custom .md command files or directories. REPLACES default commands/."
    },
    "agents": {
      "$ref": "#/$defs/agentPaths",
      "description": "Agent file paths. REPLACES default agents/. MUST be an array of individual .md files, not a directory string."
    },
    "hooks": {
      "$ref": "#/$defs/hooksValue",
      "description": "Hook config path(s), inline hooks object, or hooks.json reference."
    },
    "mcpServers": {
      "$ref": "#/$defs/mcpServersValue",
      "description": "MCP server config path(s) or inline server map."
    },
    "lspServers": {
      "$ref": "#/$defs/lspServersValue",
      "description": "LSP server config path(s) or inline server map."
    },
    "outputStyles": {
      "$ref": "#/$defs/pathOrPaths",
      "description": "Custom output style files/directories. REPLACES default output-styles/."
    },
    "experimental": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "themes": {
          "$ref": "#/$defs/pathOrPaths",
          "description": "Color theme files/directories. REPLACES default themes/."
        },
        "monitors": {
          "$ref": "#/$defs/pathOrPaths",
          "description": "Background monitor configs. REPLACES default monitors/."
        }
      }
    },

    "userConfig": {
      "type": "object",
      "description": "Values Claude Code prompts for when the plugin is enabled.",
      "additionalProperties": { "$ref": "#/$defs/userConfigEntry" }
    },
    "channels": {
      "type": "array",
      "items": { "$ref": "#/$defs/channel" }
    },
    "dependencies": {
      "type": "array",
      "items": { "$ref": "#/$defs/dependency" }
    }
  },

  "$defs": {
    "relativePath": {
      "type": "string",
      "pattern": "^\\./.+",
      "description": "Plugin-relative path. Must start with './'."
    },
    "pathOrPaths": {
      "oneOf": [
        { "$ref": "#/$defs/relativePath" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/relativePath" },
          "minItems": 1,
          "uniqueItems": true
        }
      ]
    },
    "agentPaths": {
      "description": "Agents MUST be individual file paths, never a directory string.",
      "oneOf": [
        {
          "type": "string",
          "pattern": "^\\./.+\\.md$"
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^\\./.+\\.md$"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      ]
    },
    "hooksValue": {
      "oneOf": [
        { "$ref": "#/$defs/relativePath" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/relativePath" }
        },
        { "$ref": "#/$defs/inlineHooks" }
      ]
    },
    "inlineHooks": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^(SessionStart|Setup|UserPromptSubmit|UserPromptExpansion|PreToolUse|PermissionRequest|PermissionDenied|PostToolUse|PostToolUseFailure|PostToolBatch|Notification|SubagentStart|SubagentStop|TaskCreated|TaskCompleted|Stop|StopFailure|TeammateIdle|InstructionsLoaded|ConfigChange|CwdChanged|FileChanged|WorktreeCreate|WorktreeRemove|PreCompact|PostCompact|Elicitation|ElicitationResult|SessionEnd)$": {
          "type": "array",
          "items": { "$ref": "#/$defs/hookEntry" }
        }
      }
    },
    "hookEntry": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": true,
      "properties": {
        "type": {
          "enum": ["command", "http", "mcp_tool", "prompt", "agent"]
        },
        "matcher": { "type": "string" },
        "command": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "tool": { "type": "string" },
        "prompt": { "type": "string" },
        "agent": { "type": "string" },
        "timeout": { "type": "integer", "minimum": 0 }
      }
    },
    "mcpServersValue": {
      "oneOf": [
        { "$ref": "#/$defs/relativePath" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/relativePath" }
        },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/mcpServer" }
        }
      ]
    },
    "mcpServer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command"],
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "args": {
          "type": "array",
          "items": { "type": "string" }
        },
        "env": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "cwd": { "type": "string" }
      }
    },
    "lspServersValue": {
      "oneOf": [
        { "$ref": "#/$defs/relativePath" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/relativePath" }
        },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/lspServer" }
        }
      ]
    },
    "lspServer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "extensionToLanguage"],
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "extensionToLanguage": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "args": {
          "type": "array",
          "items": { "type": "string" }
        },
        "transport": { "enum": ["stdio", "socket"] },
        "env": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "initializationOptions": { "type": "object" },
        "settings": { "type": "object" },
        "workspaceFolder": { "type": "string" },
        "startupTimeout": { "type": "integer", "minimum": 0 },
        "shutdownTimeout": { "type": "integer", "minimum": 0 },
        "restartOnCrash": { "type": "boolean" },
        "maxRestarts": { "type": "integer", "minimum": 0 }
      }
    },
    "userConfigEntry": {
      "type": "object",
      "required": ["type", "title", "description"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": ["string", "number", "boolean", "directory", "file"]
        },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "sensitive": { "type": "boolean" },
        "required": { "type": "boolean" },
        "default": {},
        "multiple": { "type": "boolean" },
        "min": { "type": "number" },
        "max": { "type": "number" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "number" } }, "required": ["type"] },
          "then": {
            "properties": {
              "min": { "type": "number" },
              "max": { "type": "number" },
              "multiple": false
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "string" } }, "required": ["type"] },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["min"] },
                { "required": ["max"] }
              ]
            }
          }
        },
        {
          "if": {
            "properties": { "type": { "enum": ["boolean", "directory", "file"] } },
            "required": ["type"]
          },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["min"] },
                { "required": ["max"] },
                { "required": ["multiple"] }
              ]
            }
          }
        }
      ]
    },
    "channel": {
      "type": "object",
      "required": ["server"],
      "additionalProperties": false,
      "properties": {
        "server": {
          "type": "string",
          "minLength": 1,
          "description": "MUST match a key in mcpServers."
        },
        "userConfig": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/userConfigEntry" }
        }
      }
    },
    "dependency": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "required": ["name"],
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 }
          }
        }
      ]
    }
  }
}
