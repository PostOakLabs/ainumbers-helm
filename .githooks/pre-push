#!/bin/sh
# Pre-push shift-left gate (HELM-SHIFTLEFT-1). Runs the CI gates in CI order
# (.github/workflows/ci.yml), so a red tree never reaches CI (green here ==
# green in CI). Enabled per-clone via `core.hooksPath = .githooks`; run
# `node scripts/setup-hooks.mjs` once after cloning (worktrees inherit it).
#
# Emergency bypass (use sparingly): git push --no-verify
#
# CI remains the real backstop — this hook only enforces locally and can be
# bypassed.

set -e

echo "pre-push: hook↔CI parity (no gate drift) ..."
node scripts/check-hook-ci-parity.mjs

echo "pre-push: internal-lang leak ..."
node scripts/check-internal-lang-leak.mjs

echo "pre-push: copy hallmarks ..."
node scripts/check-copy-hallmarks.mjs

echo "pre-push: lint ..."
node scripts/lint.mjs

echo "pre-push: check-agent-kit (regenerated kit byte-compare) ..."
node scripts/check-agent-kit.mjs

echo "pre-push: test ..."
node scripts/test.mjs

echo "pre-push: validate control-plane schemas ..."
node scripts/validate-schemas.mjs

# HELM-REGISTRY-LIST-1. CI's mcp-publisher validate step (the downloaded,
# pinned registry binary) is CI-only by construction — this zero-dep policy
# gate is the hook-side half of that pair (see ci.yml for the measured
# validate-vs-policy split).
echo "pre-push: MCP Registry server.json policy gate ..."
node scripts/check-server-json.mjs

echo "pre-push: verify vendored OCG integrity ..."
node scripts/verify-vendored.mjs

echo "pre-push: credits registry coverage ..."
node scripts/check-credits-coverage.mjs helm

echo "pre-push: credits notices freshness ..."
node scripts/gen-credits.mjs helm --check

echo "pre-push: compile parity gate ..."
node scripts/compile-parity-gate.mjs

echo "pre-push: techdoc citation drift ..."
node scripts/check-techdoc-citations.mjs

echo "pre-push: sea build dry-run ..."
node scripts/sea-dry-run.mjs

echo "pre-push: all gates green."
